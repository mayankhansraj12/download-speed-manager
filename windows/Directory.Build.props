<Project>
  <!--
    One place for the version and the update feed of every project under windows\.
    Local builds are 1.0.0 with no update feed. The release workflow overrides both:
      dotnet publish -p:Version=1.2.3 -p:UpdateRepository=owner/repo
  -->
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <UpdateRepository Condition="'$(UpdateRepository)' == ''"></UpdateRepository>
    <Authors>Download Speed Manager contributors</Authors>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
